<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.client.controller.AccountController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="Twoje Konto">
        <font><Font name="System Bold" size="22.0"/></font>
    </Label>

    <GridPane vgap="10" hgap="10">
        <Label text="Login:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="usernameField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-background-color: #eee;"/>

        <Label text="Email (tylko do odczytu):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="emailField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-background-color: #eee;"/>

        <Label text="Imię:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="firstNameField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Nazwisko:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="lastNameField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Zapisz zmiany" onAction="#saveChanges" style="-fx-background-color: #0f62fe; -fx-text-fill: white;"/>
        <Button text="Usuń moje konto" onAction="#deleteAccount" style="-fx-background-color: darkred; -fx-text-fill: white;"/>
    </HBox>

    <Label fx:id="statusLabel"/>
</VBox>