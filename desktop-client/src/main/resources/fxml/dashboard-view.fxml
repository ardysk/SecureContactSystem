<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.client.controller.DashboardController">

    <left>
        <VBox spacing="10.0" style="-fx-background-color: #f4f4f4;" BorderPane.alignment="CENTER">
            <children>
                <Label text="MENU" textFill="gray">
                    <font><Font name="System Bold" size="12.0" /></font>
                    <VBox.margin><Insets bottom="10.0" left="10.0" top="20.0" /></VBox.margin>
                </Label>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                        text="Dashboard"
                        onAction="#onDashboardClick"> <VBox.margin><Insets left="10.0" right="10.0" /></VBox.margin>
                </Button>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                        text="Kontakty"
                        onAction="#onContactsClick"> <VBox.margin><Insets left="10.0" right="10.0" /></VBox.margin>
                </Button>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                        text="Poczta"
                        onAction="#onMailClick"> <VBox.margin><Insets left="10.0" right="10.0" /></VBox.margin>
                </Button>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                        text="Pliki FTP"
                        onAction="#onFtpClick"> <VBox.margin><Insets left="10.0" right="10.0" /></VBox.margin>
                </Button>

                <Button fx:id="adminPanelButton"  maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                        text="Panel Admina"
                        onAction="#onAdminPanelClick"
                        style="-fx-background-color: #ffcccc; -fx-text-fill: black;">
                    <VBox.margin><Insets left="10.0" right="10.0" /></VBox.margin>
                </Button>

                <Button text="Wyloguj" style="-fx-text-fill: red;"
                        onAction="#onLogoutClick">
                    <VBox.margin><Insets left="10.0" right="10.0" top="20.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #0f62fe; -fx-padding: 10;">
            <children>
                <Label text="SECS Enterprise System" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Separator orientation="VERTICAL" />
                <Label fx:id="welcomeLabel" text="Witaj, Admin" textFill="WHITE" />
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Przegląd Systemu">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <VBox style="-fx-border-color: #dddddd; -fx-border-radius: 5; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                        <Label text="Statystyka Kontaktów" style="-fx-font-weight: bold;"/>
                        <PieChart fx:id="statsChart" title="Wiek Kontaktów" />
                    </VBox>

                    <VBox spacing="10.0" style="-fx-border-color: #dddddd; -fx-border-radius: 5; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Ostatnie Zdarzenia (Audit Service)" style="-fx-font-weight: bold;"/>
                            <Button text="Odśwież" onAction="#refreshAuditLogs" />
                        </HBox>

                        <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colType" prefWidth="100.0" text="Typ" />
                                <TableColumn fx:id="colUser" prefWidth="100.0" text="User" />
                                <TableColumn fx:id="colMsg" prefWidth="200.0" text="Wiadomość" />
                                <TableColumn fx:id="colTime" prefWidth="150.0" text="Czas" />
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #e0e0e0; -fx-padding: 5;">
            <Label text="Gateway Status: Connected (Port 8000)" textFill="GREEN"/>
        </HBox>
    </bottom>

</BorderPane>