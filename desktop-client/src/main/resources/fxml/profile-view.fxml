<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.client.controller.ProfileController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="Moje Konto"><font><Font size="24.0"/></font></Label>

    <Label text="Nazwa użytkownika (Login):"/>
    <TextField fx:id="usernameField" disable="true"/> <Label text="Imię:"/>
    <TextField fx:id="firstNameField"/>

    <Label text="Nazwisko:"/>
    <TextField fx:id="lastNameField"/>

    <Button text="Zapisz Zmiany" onAction="#saveChanges" style="-fx-background-color: #0f62fe; -fx-text-fill: white;"/>
    <Label fx:id="statusLabel"/>
</VBox>