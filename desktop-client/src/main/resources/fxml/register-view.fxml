<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.client.controller.RegisterController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Rejestracja Konta">
        <font><Font size="24.0" /></font>
    </Label>

    <TextField fx:id="userField" promptText="Nazwa użytkownika" maxWidth="300.0"/>
    <TextField fx:id="emailField" promptText="Email" maxWidth="300.0"/>
    <TextField fx:id="addressField" promptText="Adres zamieszkania" maxWidth="300.0"/>
    <TextField fx:id="ageField" promptText="Wiek" maxWidth="300.0"/>
    <PasswordField fx:id="passField" promptText="Hasło" maxWidth="300.0"/>

    <Button text="Zarejestruj się" onAction="#onRegister"
            style="-fx-background-color: #0f62fe; -fx-text-fill: white;"
            maxWidth="300.0" defaultButton="true"/>

    <Button text="Wróć do logowania" onAction="#onBack"
            style="-fx-background-color: transparent; -fx-text-fill: #0f62fe; -fx-underline: true;"/>

    <Label fx:id="infoLabel" text="" wrapText="true" maxWidth="300.0"/>
</VBox>